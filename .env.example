APP_APP_ORIGIN=https://your-domain.com
APP_DATABASE_PATH=data/app.db
APP_DOWNLOADS_DIR=data/downloads
APP_MAX_CONCURRENT_JOBS=2
# Optional YouTube hardening. Set APP_YTDLP_IMPERSONATE= to disable.
APP_YTDLP_IMPERSONATE=chrome
# Optional: only for your own private deployment if YouTube challenges your host IP.
# Prefer APP_YTDLP_COOKIES_PATH when you can mount a cookies.txt file.
# APP_YTDLP_COOKIES_PATH=/app/secrets/youtube.cookies.txt
# APP_YTDLP_COOKIES="# Netscape HTTP Cookie File ..."
